<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gibson9583</groupId>
    <artifactId>oie-debugger</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>OIE JavaScript Debugger Plugin</name>
    <description>Headless Rhino JavaScript debugger for OIE</description>
    <url>https://github.com/gibson9583/oie-debugger</url>
    <licenses>
        <license>
            <name>Mozilla Public License 2.0</name>
            <url>https://www.mozilla.org/MPL/2.0/</url>
        </license>
    </licenses>

    <modules>
        <module>shared</module>
        <module>server</module>
        <module>package</module>
    </modules>

    <properties>
        <!-- Keep release, catalog, and webadmin versions in sync. -->
        <revision>1.0.2</revision>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Engine artifacts to COMPILE against. Install engine jars first
             via scripts/install-engine-jars.sh (CI installs them from the
             published OIE distribution instead). -->
        <mirth.version>4.6.0</mirth.version>
        <!-- Engine versions the packaged plugin DECLARES support for
             (plugin.xml <mirthVersion> — the extension loader only loads a
             plugin whose list contains the running engine version). -->
        <plugin.supported.oie.versions>4.6.0,4.7.0</plugin.supported.oie.versions>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- OIE -->
            <dependency>
                <groupId>com.mirth.connect</groupId>
                <artifactId>mirth-server</artifactId>
                <version>${mirth.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.mirth.connect</groupId>
                <artifactId>mirth-client-core</artifactId>
                <version>${mirth.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.mirth.connect</groupId>
                <artifactId>mirth-client</artifactId>
                <version>${mirth.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.mirth.connect</groupId>
                <artifactId>donkey-model</artifactId>
                <version>${mirth.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>io.github.gibson9583</groupId>
                <artifactId>oie-debugger-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>17</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
