        <dependency><groupId>com.mirth.connect</groupId><artifactId>mirth-crypto</artifactId><version>${mirth.version}</version><scope>test</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
